Geometry x="40" y="152" width="185" height="14" as="geometry" /></mxCell><mxCell id="p03f2" value="2. 2. permission_set 设置策略" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=10;fontStyle=1;shadow=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="35" y="174" width="195" height="34" as="geometry" /></mxCell><mxCell id="p03fd2" value="tool_pattern + policy 三态" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=9;fontColor=#666666;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="208" width="185" height="14" as="geometry" /></mxCell><mxCell id="p03f3" value="3. 3. 工具调用触发闸门" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7d5600;strokeColor=none;fontSize=10;fontStyle=1;shadow=1;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="35" y="230" width="195" height="34" as="geometry" /></mxCell><mxCell id="p03fd3" value="AgentRuntime 分发前检查" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=9;fontColor=#666666;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="264" width="185" height="14" as="geometry" /></mxCell><mxCell id="p03f4" value="4. 4. confirm 走人工确认" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=10;fontStyle=1;shadow=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="35" y="286" width="195" height="34" as="geometry" /></mxCell><mxCell id="p03fd4" value="console 询问 y/n" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=9;fontColor=#666666;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="185" height="14" as="geometry" /></mxCell><mxCell id="p03f5" value="5. 5. deny 拒绝 / allow 放行" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=10;fontStyle=1;shadow=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="35" y="342" width="195" height="34" as="geometry" /></mxCell><mxCell id="p03fd5" value="拒绝返回 Error 不执行" style="tex