        <mxCell id="p3srcnote1" value="关键设计: 每个阶段只是在同一个 AgentRuntime 上逐步打开更多能力开关" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=9;fontColor=#7d5600;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="654" width="510" height="18" as="geometry" /></mxCell>
        <mxCell id="p3key" value="核心要点: Todo 是模型的“外置内存”，帮助它拆解大任务、跟踪进度、不偏离规划  |  todoNag = 强制规划约束" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;align=left;spacingLeft=10;shadow=1;" vertex="1" parent="1"><mxGeometry x="30" y="678" width="740" height="28" as="geometry" /></mxCell>
