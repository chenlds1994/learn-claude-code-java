        <mxCell id="p2sl2_1" value="❶ Files.readAllLines(safeResolve(path))" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=9;fontColor=#333333;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="418" y="574" width="365" height="15" as="geometry" /></mxCell>
