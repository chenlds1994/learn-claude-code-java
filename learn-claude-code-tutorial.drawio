ry" /></mxCell><mxCell id="p03sl2_2" value="❷ 用户输入 y/n" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=9;fontColor=#333333;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="418" y="590" width="365" height="15" as="geometry" /></mxCell><mxCell id="p03sl2_3" value="❸ deny 时返回 Error 字符串" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=9;fontColor=#333333;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="418" y="606" width="365" height="15" as="geometry" /></mxCell><mxCell id="p03sc3" value="规则持久化" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="796" y="548" width="370" height="22" as="geometry" /></mxCell><mxCell id="p03sl3_1" value="❶ 规则文件持久化存储" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=9;fontColor=#333333;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="801" y="574" width="365" height="15" as="geometry" /></mxCell><mxCell id="p03sl3_2" value="❷ synchronized 并发安全" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=9;fontColor=#333333;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="801" y="590" width="365" height="15" as="geometry" /></mxCell><mxCell id="p03sl3_3" value="❸ listRules() 输出决策依据" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=9;fontColor=#333333;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="801" y="606" width="365" height="15" as="geometry" /></mxCell><mxCell id="p03ann1" value="❶❷: s03 配置 = s02 工具 + permission_list/set + enablePermission=true" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;align=left;spacingLeft=5;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="630" width="385" height="20" as="geometry" /></mxCell><mxCell id="p03ann2" value="❶❷❸: 权限本质 = 显式策略 + 三态决策 + 敏感操作人工兜底" style="rounded=1;whiteSpace=