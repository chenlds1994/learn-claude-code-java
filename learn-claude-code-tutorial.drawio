        <mxCell id="p2title" value="S02 Tool Use — 文件工具拓展" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;fontColor=#2d5016;" vertex="1" parent="1"><mxGeometry x="80" y="30" width="500" height="35" as="geometry" /></mxCell>
        <mxCell id="p2desc" value="核心思想: 从只有 bash 到 bash+read+write+edit，Agent 才真正能读写代码" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="80" y="62" width="600" height="22" as="geometry" /></mxCell>
