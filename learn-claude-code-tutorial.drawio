  <diagram id="page_1" name="S01 Agent Loop">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p1bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=3;shadow=1;" vertex="1" parent="1"><mxGeometry x="15" y="15" width="1140" height="797" as="geometry" /></mxCell>
        <mxCell id="p1badge" value="01" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1e3a5f;strokeColor=none;fontColor=#ffffff;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="28" width="42" height="42" as="geometry" /></mxCell>
        <mxCell id="p1title" value="S01 Agent Loop — 最小 Agent 闭环" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;fontColor=#1e3a5f;" vertex="1" parent="1"><mxGeometry x="80" y="30" width="500" height="35" as="geometry" /></mxCell>
        <mxCell id="p1desc" value="核心思想: 模型不是一次性完成任务，而是 while(true) { 思考→行动→观察 } 的循环系统" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="80" y="62" width="600" height="22" as="geometry" /></mxCell>
        <mxCell id="p1sec1" value="Agent Loop 流程图" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontStyle=1;fontColor=#1e3a5f;" vertex="1" parent="1"><mxGeometry x="30" y="92" width="200" height="20" as="geometry" /></mxCell>
        <mxCell id="p1n1" value="1. 用户输入&lt;br&gt;Scanner.nextLine()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10;fontStyle=1;shadow=1;" vertex="1" parent="1"><mxGeometry x="35" y="118" width="155" height="42" as="geometry" /></mxCell>
        <mxCell id="p1n2" value="2. messages.add&lt;br&gt;ChatMessage(&quot;user&quot;)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10;shadow=1;" vertex="1" parent="1"><mxGeometry x="35" y="175" width="155" height="42" as="geometry" /></mxCell>
        <mxCell id="p1n3" value="3. client.createMessage()&lt;br&gt;HTTP POST /v1/messages" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e3a5f;strokeColor=none;fontColor=#ffffff;fontSize=10;fontStyle=1;shadow=1;" vertex="1" parent="1"><mxGeometry x="35" y="232" width="155" height="42" as="geometry" /></mxCell>
        <mxCell id="p1n4" value="4. stop_reason?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;fontStyle=1;shadow=1;" vertex="1" parent="1"><mxGeometry x="255" y="175" width="115" height="65" as="geometry" /></mxCell>
        <mxCell id="p1n5" value="end_turn&lt;br&gt;输出文本, return" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;shadow=1;" vertex="1" parent="1"><mxGeometry x="425" y="140" width="115" height="38" as="geometry" /></mxCell>
        <mxCell id="p1n6" value="tool_use&lt;br&gt;进入工具分发" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;fontStyle=1;shadow=1;" vertex="1" parent="1"><mxGeometry x="425" y="195" width="115" height="38" as="geometry" /></mxCell>
        <mxCell id="p1n7" value="5. switch(toolName)&lt;br&gt;case &quot;bash&quot; -&gt; runBash()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=10;shadow=1;" vertex="1" parent="1"><mxGeometry x="255" y="260" width="155" height="42" as="geometry" /></mxCell>
        <mxCell id="p1n8" value="6. tool_result&lt;br&gt;messages.add(user, results)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10;shadow=1;" vertex="1" parent="1"><mxGeometry x="35" y="295" width="155" height="42" as="geometry" /></mxCell>
        <mxCell id="p1e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#6c8ebf;endArrow=classic;" edge="1" source="p1n1" target="p1n2" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p1e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#6c8ebf;endArrow=classic;" edge="1" source="p1n2" target="p1n3" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p1e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#6c8ebf;endArrow=classic;" edge="1" source="p1n3" target="p1n4" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p1e4" value="end_turn" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#82b366;endArrow=classic;fontSize=9;" edge="1" source="p1n4" target="p1n5" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p1e5" value="tool_use" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#b85450;endArrow=classic;fontSize=9;" edge="1" source="p1n4" target="p1n6" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p1e6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#b85450;endArrow=classic;" edge="1" source="p1n6" target="p1n7" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p1e7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#6c8ebf;endArrow=classic;" edge="1" source="p1n7" target="p1n8" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p1e8" value="while(true)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#6c8ebf;endArrow=classic;dashed=1;fontSize=9;" edge="1" source="p1n8" target="p1n3" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="112" y="352" /><mxPoint x="18" y="352" /><mxPoint x="18" y="253" /></Array></mxGeometry></mxCell>
        <mxCell id="p1sec2" value="代码执行时序" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontStyle=1;fontColor=#1e3a5f;" vertex="1" parent="1"><mxGeometry x="580" y="92" width="200" height="20" as="geometry" /></mxCell>
        <mxCell id="p1s1" value="1  S01AgentLoop.main() -&gt; 入口" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="580" y="118" width="240" height="26" as="geometry" /></mxCell>
        <mxCell id="p1s2" value="2  Launcher.launch(s01) -&gt; 选择阶段配置" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="580" y="150" width="240" height="26" as="geometry" /></mxCell>
        <mxCell id="p1s3" value="3  new AppContext() -&gt; 装配所有共享服务" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e3a5f;strokeColor=none;fontColor=#ffffff;fontSize=10;fontStyle=1;align=left;spacingLeft=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="580" y="182" width="240" height="26" as="geometry" /></mxCell>
        <mxCell id="p1s4" value="4  runtime.runRepl(config) -&gt; REPL循环" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="580" y="214" width="240" height="26" as="geometry" /></mxCell>
        <mxCell id="p1s5" value="5  history.add(ChatMessage) -&gt; 用户消息入队" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="580" y="246" width="240" height="26" as="geometry" /></mxCell>
        <mxCell id="p1s6" value="6  agentLoop() -&gt; while(true) 核心循环" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;fontStyle=1;align=left;spacingLeft=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="580" y="278" width="240" height="26" as="geometry" /></mxCell>
        <mxCell id="p1s7" value="7  client.createMessage() -&gt; HTTP POST" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="580" y="310" width="240" height="26" as="geometry" /></mxCell>
        <mxCell id="p1apibox" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;arcSize=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="845" y="118" width="295" height="220" as="geometry" /></mxCell>
        <mxCell id="p1apihdr" value="Anthropic Messages API 请求体" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="845" y="120" width="295" height="20" as="geometry" /></mxCell>
        <mxCell id="p1apicode" value="&lt;font style=&quot;font-family:Courier New;font-size:9px&quot;&gt;{&lt;br&gt;  &quot;model&quot;: &quot;claude-sonnet-4-20250514&quot;,&lt;br&gt;  &quot;max_tokens&quot;: 8000,&lt;br&gt;  &quot;system&quot;: &quot;You are a coding agent...&quot;,&lt;br&gt;  &quot;messages&quot;: [{ role, content }],&lt;br&gt;  &quot;tools&quot;: [{ name, input_schema }]&lt;br&gt;}&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=9;fontColor=#1e3a5f;spacingLeft=5;" vertex="1" parent="1"><mxGeometry x="855" y="145" width="275" height="95" as="geometry" /></mxCell>
        <mxCell id="p1apiresp" value="&lt;font style=&quot;font-family:Courier New;font-size:9px&quot;&gt;响应: stop_reason = &quot;end_turn&quot; | &quot;tool_use&quot;&lt;br&gt;content = [{type:&quot;text&quot;,...}] | [{type:&quot;tool_use&quot;,...}]&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=9;fontColor=#b85450;spacingLeft=5;" vertex="1" parent="1"><mxGeometry x="855" y="248" width="275" height="42" as="geometry" /></mxCell>
        <mxCell id="p1s8arrow" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#d6b656;endArrow=classic;dashed=1;" edge="1" source="p1s7" target="p1apibox" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p1sec3" value="关键类说明" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontStyle=1;fontColor=#1e3a5f;" vertex="1" parent="1"><mxGeometry x="30" y="370" width="200" height="20" as="geometry" /></mxCell>
        <mxCell id="p1c1" value="&lt;b&gt;AgentRuntime&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;核心循环执行器&lt;br&gt;runRepl() - REPL入口&lt;br&gt;agentLoop() - while(true)主循环&lt;br&gt;switch(toolName) - 工具分发&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=2;shadow=1;" vertex="1" parent="1"><mxGeometry x="30" y="395" width="178" height="78" as="geometry" /></mxCell>
        <mxCell id="p1c2" value="&lt;b&gt;AnthropicClient&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;模型网关&lt;br&gt;createMessage() - HTTP POST&lt;br&gt;封装认证头/超时/错误&lt;br&gt;兼容 Anthropic + 第三方&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=2;shadow=1;" vertex="1" parent="1"><mxGeometry x="218" y="395" width="178" height="78" as="geometry" /></mxCell>
        <mxCell id="p1c3" value="&lt;b&gt;StageConfig&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;阶段配置器 (record)&lt;br&gt;s01() = 只开 bash&lt;br&gt;system prompt + tools + 开关&lt;br&gt;能力增量式叠加&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=2;shadow=1;" vertex="1" parent="1"><mxGeometry x="406" y="395" width="178" height="78" as="geometry" /></mxCell>
        <mxCell id="p1c4" value="&lt;b&gt;Launcher&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;统一启动器&lt;br&gt;launch(config) -&gt;&lt;br&gt;  new AppContext()&lt;br&gt;  .runtime().runRepl(config)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=2;shadow=1;" vertex="1" parent="1"><mxGeometry x="594" y="395" width="178" height="78" as="geometry" /></mxCell>
        <mxCell id="p1c5" value="&lt;b&gt;AppContext&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;总装车间&lt;br&gt;按层装配: 环境-&gt;基础-&gt;扩展&lt;br&gt;EnvConfig -&gt; AnthropicClient&lt;br&gt;-&gt; AgentRuntime&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=2;shadow=1;" vertex="1" parent="1"><mxGeometry x="782" y="395" width="178" height="78" as="geometry" /></mxCell>
        <mxCell id="p1c6" value="&lt;b&gt;ChatMessage&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;消息记录 (record)&lt;br&gt;role: &quot;user&quot;|&quot;assistant&quot;&lt;br&gt;content: String | List&lt;br&gt;兼容文本+tool_result&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=2;shadow=1;" vertex="1" parent="1"><mxGeometry x="970" y="395" width="170" height="78" as="geometry" /></mxCell>
        <mxCell id="p1sec4" value="源码阅读注释" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontStyle=1;fontColor=#1e3a5f;" vertex="1" parent="1"><mxGeometry x="30" y="488" width="200" height="20" as="geometry" /></mxCell>
        <mxCell id="p1srcbox" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;arcSize=5;shadow=1;" vertex="1" parent="1"><mxGeometry x="30" y="512" width="1110" height="210" as="geometry" /></mxCell>
        <mxCell id="p1src1title" value="AgentRuntime.runRepl() - REPL交互循环 (第97-123行)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontStyle=1;fontColor=#1e3a5f;" vertex="1" parent="1"><mxGeometry x="40" y="515" width="350" height="16" as="geometry" /></mxCell>
        <mxCell id="p1src1" value="&lt;font style=&quot;font-family:Courier New;font-size:9px&quot;&gt;while (true) {                           // ❶ REPL主循环&lt;br&gt;  String query = scanner.nextLine();    // ❷ 读用户输入&lt;br&gt;  history.add(new ChatMessage(&quot;user&quot;,  // ❸ 用户消息入队&lt;br&gt;      query));&lt;br&gt;  agentLoop(history, config);            // ❹ 进入Agent核心循环&lt;br&gt;  // 打印 assistant 最终文本回复&lt;br&gt;}&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=9;fontColor=#333333;spacingLeft=5;" vertex="1" parent="1"><mxGeometry x="40" y="533" width="350" height="88" as="geometry" /></mxCell>
        <mxCell id="p1src2title" value="AgentRuntime.agentLoop() - 核心决策循环 (第131-261行)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontStyle=1;fontColor=#1e3a5f;" vertex="1" parent="1"><mxGeometry x="415" y="515" width="400" height="16" as="geometry" /></mxCell>
        <mxCell id="p1src2" value="&lt;font style=&quot;font-family:Courier New;font-size:9px&quot;&gt;while (true) {                               // ❺ Agent主循环&lt;br&gt;  var response = client.createMessage(...);   // ❻ 调用大模型&lt;br&gt;  messages.add(new ChatMessage(&quot;assistant&quot;, response.content()));&lt;br&gt;  if (!&quot;tool_use&quot;.equals(response.stop_reason()))&lt;br&gt;    return;                                  // ❼ 非tool_use则结束&lt;br&gt;  String output = switch (toolName) {          // ❽ 工具分发&lt;br&gt;    case &quot;bash&quot; -&gt; commandTools.runBash(cmd);  // ❾ 本地执行&lt;br&gt;  };&lt;br&gt;  messages.add(new ChatMessage(&quot;user&quot;, results)); // ❿ 结果回注&lt;br&gt;}&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=9;fontColor=#333333;spacingLeft=5;" vertex="1" parent="1"><mxGeometry x="415" y="533" width="395" height="120" as="geometry" /></mxCell>
        <mxCell id="p1src3title" value="StageConfig.s01() - 最小能力配置 (第77-82行)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontStyle=1;fontColor=#1e3a5f;" vertex="1" parent="1"><mxGeometry x="835" y="515" width="300" height="16" as="geometry" /></mxCell>
        <mxCell id="p1src3" value="&lt;font style=&quot;font-family:Courier New;font-size:9px&quot;&gt;public static StageConfig s01() {&lt;br&gt;  // ➀ 只开放bash,&lt;br&gt;  // 理解最原始闭环&lt;br&gt;  return new StageConfig(&lt;br&gt;    &quot;s01&quot;, false, false, false,&lt;br&gt;    false, false, false,&lt;br&gt;    List.of(baseTools().get(0)),&lt;br&gt;    // ➁ system prompt&lt;br&gt;    // 指示Act不要解释&lt;br&gt;    &quot;You are a coding agent...&quot;&lt;br&gt;  );&lt;br&gt;}&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=9;fontColor=#333333;spacingLeft=5;" vertex="1" parent="1"><mxGeometry x="835" y="533" width="295" height="120" as="geometry" /></mxCell>
        <mxCell id="p1ann1" value="❶❷❸❹: 外层 REPL 收集用户输入，转为 messages[]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;align=left;spacingLeft=5;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="665" width="340" height="20" as="geometry" /></mxCell>
        <mxCell id="p1ann2" value="❺❻❼❽❾❿: 内层 agentLoop 是 Agent 真正的决策循环" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;align=left;spacingLeft=5;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="415" y="665" width="395" height="20" as="geometry" /></mxCell>
        <mxCell id="p1ann3" value="➀➁: s01 最小配置 = 只有bash + 行动导向prompt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;align=left;spacingLeft=5;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="835" y="665" width="295" height="20" as="geometry" /></mxCell>
        <mxCell id="p1srcnote1" value="关键设计: 每次循环只问模型&quot;当前这一步该做什么&quot;，这正是 Agent 与普通聊天调用的差异" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=9;fontColor=#7d5600;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="692" width="510" height="18" as="geometry" /></mxCell>
        <mxCell id="p1srcnote2" value="工具执行后结果回注到 messages[]，模型下一轮就能基于&quot;刚刚执行后的真实世界状态&quot;继续推理" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=9;fontColor=#7d5600;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="712" width="530" height="18" as="geometry" /></mxCell>
        <mxCell id="p1key" value="核心要点: Agent = while(true) { 调模型 → 判断stop_reason → 执行工具 → 结果回注 }  |  LLM负责决策，Java代码负责执行" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;align=left;spacingLeft=10;shadow=1;" vertex="1" parent="1"><mxGeometry x="30" y="740" width="740" height="28" as="geometry" /></mxCell>
        <mxCell id="p1code" value="核心代码: AgentRuntime.agentLoop() 第131-261行  |  入口: S01AgentLoop.java" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;spacingLeft=10;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="30" y="776" width="500" height="24" as="geometry" /></mxCell>
        <mxCell id="p1run" value="mvn exec:java -Dexec.mainClass=com.learnclaudecode.agents.S01AgentLoop" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e3a5f;strokeColor=none;fontColor=#ffffff;fontSize=10;align=left;spacingLeft=10;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="540" y="776" width="530" height="24" as="geometry" /></mxCell>
        <mxCell id="p1page" value="1 / 13" style="text;html=1;align=right;verticalAlign=bottom;fontSize=10;fontColor=#999999;" vertex="1" parent="1"><mxGeometry x="1075" y="795" width="60" height="15" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p2" name="S02 Tool Use">
      <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
        <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
