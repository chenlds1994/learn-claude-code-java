        <mxCell id="p4ann1" value="❶❷: s06 配置 = s05 工具 + task 工具" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;align=left;spacingLeft=5;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="630" width="385" height="20" as="geometry" /></mxCell>
        <mxCell id="p4ann2" value="❶❷❸: 子代理本质是“新开一个更小的 Agent 上下文”而非新进程" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;align=left;spacingLeft=5;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="425" y="630" width="385" height="20" as="geometry" /></mxCell>
        <mxCell id="p4srcnote1" value="关键设计: 每个阶段只是在同一个 AgentRuntime 上逐步打开更多能力开关" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=9;fontColor=#7d5600;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="654" width="510" height="18" as="geometry" /></mxCell>
        <mxCell id="p4key" value="核心要点: Subagent = 独立上下文 + 独立循环 + 只返回摘要  |  分治思想：主对话不被探索细节污染" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;align=left;spacingLeft=10;shadow=1;" vertex="1" parent="1"><mxGeometry x="30" y="678" width="740" height="28" as="geometry" /></mxCell>
        <mxCell id="p4code" value="核心代码: AgentRuntime.runSubagent()  |  工具定义: StageConfig.s06()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;spacingLeft=10;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="30" y="712" width="500" height="24" as="geometry" /></mxCell>
